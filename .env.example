# Postgres connection string (Neon / Vercel Postgres / Supabase / local)
# e.g. postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Gemini model to use for explanations
GEMINI_MODEL=gemini-2.0-flash

# Port for local dev only (Vercel ignores this)
PORT=8080

# Comma separated list of allowed origins for CORS (your Vercel frontend URL)
CORS_ORIGIN=http://localhost:5173
